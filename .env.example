# Copy to .env and fill in. Only GEMINI_API_KEY is needed to generate trips.

# Required for trip generation — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. 0 skips Gemini 2.5 Flash's reasoning pass, which is much faster.
# Only applied to 2.5 Flash models.
GEMINI_THINKING_BUDGET=0

# Nominatim and Overpass are volunteer-run and ask every client to identify
# itself. Put a contact in here for anything beyond local development.
OSM_USER_AGENT=Wanderly/1.0 (you@example.com)

# Firebase — optional. Leave any of these blank and the app starts in demo
# mode, keeping trips in browser storage instead of Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
